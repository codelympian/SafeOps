# SafeOps Intelligence — example environment.
# Copy to .env and fill in. Never commit .env.
# All values below are safe placeholders.

# ---------- App ----------
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated CORS allowlist
CORS_ORIGINS=http://localhost:3000
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
JWT_EXPIRE_MINUTES=480
# true when served over HTTPS (any non-local deployment)
COOKIE_SECURE=false
# Password for the seeded demo logins (`make seed`). Demo only.
DEMO_PASSWORD=SafeOpsDemo!2026

# ---------- Database / queue ----------
POSTGRES_USER=safeops
POSTGRES_PASSWORD=change-me
POSTGRES_DB=safeops
POSTGRES_HOST=localhost
# Host port for the compose Postgres. 5433, not 5432, avoids clashing with a
# locally installed PostgreSQL (see ADR-010). Containers still use db:5432.
POSTGRES_PORT=5433
DATABASE_URL=postgresql+asyncpg://safeops:change-me@localhost:5433/safeops
REDIS_URL=redis://localhost:6379/0

# ---------- Storage ----------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
MAX_UPLOAD_MB=20

# ---------- LLM provider ----------
# mock | anthropic | openai. "mock" needs no key and labels all output [MOCK].
LLM_PROVIDER=mock
# Model IDs are always set here, never hardcoded in the code.
# Example values for LLM_PROVIDER=anthropic:
#   LLM_MODEL_STRONG=claude-sonnet-5-5
#   LLM_MODEL_FAST=claude-haiku-5-5
LLM_MODEL_STRONG=
LLM_MODEL_FAST=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ---------- Embeddings (local, open-weight) ----------
# The final choice is confirmed at the Phase 2 decision point.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
# Pinned Hugging Face Hub revision (commit hash), if the library supports it
EMBEDDING_REVISION=
# Max tokens per chunk, measured with the embedding model's tokenizer
EMBEDDING_MAX_TOKENS=512

# ---------- Reranker (local cross-encoder) ----------
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2

# ---------- Model cache (Docker named volume in compose) ----------
HF_HOME=./.cache/huggingface
FASTEMBED_CACHE_PATH=./.cache/fastembed
# Set to 1 after `make download-models` to prove the app runs offline
HF_HUB_OFFLINE=0

# ---------- Retrieval ----------
RETRIEVAL_MODE=hybrid_rerank   # vector | keyword | hybrid | hybrid_rerank
RETRIEVAL_CANDIDATES=30
RETRIEVAL_TOP_N=8
RRF_K=60
QUERY_EXPANSION=true

# ---------- Chunking ----------
CHUNK_TARGET_TOKENS=400
CHUNK_OVERLAP_RATIO=0.12

# ---------- Frontend ----------
NEXT_PUBLIC_API_URL=http://localhost:8000
