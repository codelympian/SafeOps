# ---------- Model caches (downloaded weights are never committed) ----------
.cache/
models/
.hf_cache/
hf_cache/
.fastembed_cache/
fastembed_cache/
local_cache/

# ---------- Local storage: uploaded files, Docker volume data, DB dumps ----------
storage/
uploads/
backend/storage/
docker-data/
pgdata/
redisdata/
*.dump
*.sql.gz

# ---------- Evaluation ----------
# Raw run files are ignored. Runs that back the README table are copied
# into eval/results/published/, which is committed.
eval/results/*
!eval/results/published/
!eval/results/.gitkeep

# ---------- OS / editor ----------
